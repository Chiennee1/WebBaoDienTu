<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="baoDienTu.MasterPages.SiteMaster" %>

<!DOCTYPE html>
<html lang="vi">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Báo Điện Tử</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <webopt:bundlereference runat="server" path="~/Content/css" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
    <link href="~/Static/images/favicon.ico" rel="shortcut icon" type="image/x-icon" />
</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server" EnableCdn="true">
            <Scripts>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
            </Scripts>
        </asp:ScriptManager>

        <header class="site-header">
            <div class="topbar">
                <div class="container-xl topbar-inner">
                    <div class="topbar-left">
                        <span class="newsroom-pill">Tin mới 24/7</span>
                        <span><%= RenderCurrentDate() %></span>
                    </div>
                    <div class="topbar-links"><%= RenderAuthLinks() %></div>
                </div>
            </div>
            <div class="brand-row">
                <div class="container-xl brand-inner">
                    <a class="brand-mark" runat="server" href="~/">
                        <span class="brand-symbol" aria-hidden="true"><span>BĐT</span></span>
                        <span class="brand-copy">
                            <strong>Báo Điện Tử</strong>
                            <small>Nhanh, rõ, đáng tin</small>
                        </span>
                    </a>
                    <div class="header-tools">
                        <a class="quick-link" runat="server" href="~/NewsletterSubscribe.aspx">Newsletter</a>
                        <div class="global-search">
                            <input type="search" id="globalSearch" aria-label="Tìm kiếm" placeholder="Tìm kiếm tin tức..." />
                            <button type="button" onclick="goSearch()">Tìm</button>
                        </div>
                    </div>
                </div>
            </div>
            <nav class="category-nav" aria-label="Chuyên mục">
                <div class="container-xl category-scroll">
                    <a runat="server" href="~/">Trang chủ</a>
                    <%= RenderCategoryLinks() %>
                </div>
            </nav>
        </header>

        <main class="site-main">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>

        <footer class="site-footer">
            <div class="container-xl footer-grid">
                <div class="footer-brand">
                    <a class="brand-mark footer-logo" runat="server" href="~/">
                        <span class="brand-symbol" aria-hidden="true"><span>BĐT</span></span>
                        <span class="brand-copy">
                            <strong>Báo Điện Tử</strong>
                            <small>Nhanh, rõ, đáng tin</small>
                        </span>
                    </a>
                    <p>Hệ thống báo điện tử xây dựng bằng ASP.NET Web Forms, ADO.NET và SQL Server theo mô hình 3 lớp.</p>
                </div>
                <div>
                    <h3>Độc giả</h3>
                    <a runat="server" href="~/NewsList.aspx">Tin mới nhất</a>
                    <a runat="server" href="~/Search.aspx">Tìm kiếm</a>
                    <a runat="server" href="~/NewsletterSubscribe.aspx">Newsletter</a>
                </div>
                <div>
                    <h3>Tài khoản</h3>
                    <a runat="server" href="~/Login.aspx">Đăng nhập</a>
                    <a runat="server" href="~/Register.aspx">Đăng ký độc giả</a>
                    <a runat="server" href="~/Admin/Default.aspx">Bảng điều khiển</a>
                </div>
                <div>
                    <h3>Thông tin</h3>
                    <a runat="server" href="~/About.aspx">Giới thiệu</a>
                    <a runat="server" href="~/Contact.aspx">Liên hệ</a>
                    <span>© <%= RenderFooterYear() %> Báo Điện Tử</span>
                </div>
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            function goSearch() {
                var input = document.getElementById('globalSearch');
                var q = input ? input.value.trim() : '';
                if (q.length > 0) {
                    window.location.href = '<%= ResolveUrl("~/Search.aspx") %>?q=' + encodeURIComponent(q);
                }
            }
            document.addEventListener('keydown', function (event) {
                if (event.key === 'Enter' && event.target && event.target.id === 'globalSearch') {
                    event.preventDefault();
                    goSearch();
                }
            });
        </script>
    </form>
</body>
</html>
